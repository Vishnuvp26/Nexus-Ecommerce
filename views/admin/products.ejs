<%- include("../layout/adminHeader") %>
<%- include("../layout/adminSidebarHead") %>

<style>
.swal2-popup {
    font-size: 14px;
    max-width: 320px;
    padding: 1.16rem;
    max-height: 300px !important;
}

.swal2-title {
    font-size: 15px !important;
}

.swal2-content {
    font-size: 12px !important;
}

.swal2-confirm,
.swal2-cancel {
    padding: 8px 16px;
    font-size: 14px;
}
.swal2-icon.swal2-warning {
    font-size: 10px;
}
</style>


<div class="main-panel">
    <div class="content-wrapper">
        <div class="page-header pt-5">
            <h3 class="page-title">
                <span class="page-title-icon btn-gradient-primary text-white mr-2">
                    <i class="mdi mdi-cube-outline menu-icon"></i>
                </span>Products
            </h3>
            <nav aria-label="breadcrumb">
                <ul class="breadcrumb">
                    <li class="breadcrumb-item active" aria-current="page">
                        <span></span>
                        <button class="btn btn-outline-github" onclick="location.href='/admin/addProducts'">Add Product</button>
                    </li>
                </ul>
            </nav>
            <form class="d-flex">
                <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" name="search" value="<%= searchQuery %>"/>
                <button class="btn btn-gradient-dark" type="submit">Search</button>
            </form>
        </div>

    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body table-responsive">

                <table class="table table-bordered border-top table-hover" style="width: 100%">
                    <thead class="text-center">
                        <tr>
                            <th>Product Name</th> 
                            <th>Image</th>
                            <th>Category</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Added Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(products.length > 0) { for(let i = 0; i < products.length; i++) { %>
                        <tr class="text-center">
                            <td style="
                                max-width: 250px;
                                overflow-wrap: break-word;
                                word-wrap: break-word;
                                white-space: normal;
                                line-height: 1.5;
                                font-family: sans-serif;
                            ">
                            <%= products[i].productName %>
                            </td>
                            <td>
                                <img src="/productimages/<%= products[i].image[0] %>" style="width: 100px; height: auto; border-radius: 0" />
                            </td>                        
                            <td><%= products[i].category.categoryName %></td>
                            <td><%= products[i].quantity %></td>
                            <td><%= products[i].price %></td>
                            <td><%= products[i].addedDate.toLocaleDateString() %></td>
                            <td>
                                <a href="/admin/editProducts/?id=<%= products[i]._id %>" 
                                    class="btn btn-gradient-dark edit-btn" 
                                    data-id="<%= products[i]._id %>" 
                                    data-name="<%= products[i].productName %>">
                                    Edit
                                </a>
                                <td id="product-btn-<%= products[i]._id %>">
                                    <% if (products[i].status === "active") { %>
                                        <button class="btn-sm btn-gradient-danger" onclick="toggleProductStatus('<%= products[i]._id %>', true)">
                                        Inactive
                                        </button>
                                    <% } else { %>
                                        <button class="btn-sm btn-gradient-success" onclick="toggleProductStatus('<%= products[i]._id %>', false)">
                                        Active
                                        </button>
                                    <% } %>
                                </td>
                            </td>                                                
                        </tr>
                        <% } } else { %>
                        <tr>
                            <td colspan="7" class="text-center">
                                 No such product found
                                <div class="mt-4">
                                    <a href="/admin/products" class="btn-sm btn-inverse-dark" style="text-decoration: none;">Go Back</a>
                                </div>
                            </td>
                        </tr>
                      <% } %>
                    </tbody>
                </table>

            </div>

            <div class="pagination-container mt-4">
                <ul class="pagination justify-content-center">
                    <% if (currentPage > 1) { %>
                    <li class="page-item">
                        <a class="page-link page-link-custom" href="?page=<%= currentPage - 1 %>" style="background-color: #fff; border-color: #000000; color: #000;">Previous</a>
                    </li>
                    <% } %>
                    <% for(let i = 1; i <= totalPages; i++) { %>
                     <li class="page-item <%= i === currentPage ? 'bg-dark text-light' : 'btn-light text-dark' %>" style="border-color: #000;">
                        <a class="page-link page-link-custom <%= i === currentPage ? 'bg-dark text-light' : 'btn-light text-dark' %>" href="?page=<%= i %>" style="border-color: #000;"><%= i %></a>
                    </li>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                    <li class="page-item">
                        <a class="page-link page-link-custom" href="?page=<%= currentPage + 1 %>" style="background-color: #fff; border-color: #000; color: #000;">Next</a>
                    </li>
                    <% } %>
                </ul>
            </div>
      </div>
  </div>
</div>
    <!-- content-wrapper ends -->
</div>
  <!-- main-panel ends -->

<%- include("../layout/adminSidebarFoot") %>
<%- include("../layout/adminFooter") %>

<script>
function toggleProductStatus(productId, isActive) {
    const action = isActive ? 'unlist' : 'list';
    const statusText = isActive ? 'inactive' : 'active';
    const url = `/admin/${action}Products?id=${productId}`;

    Swal.fire({
        title: `Do you want to make this product ${statusText}?`,
        icon: isActive ? 'warning' : 'question',
        showCancelButton: true,
        confirmButtonText: `Yes, make ${statusText}`,
        cancelButtonText: 'Cancel',
        reverseButtons: true
    }).then((result) => {
        if (result.isConfirmed) {
            axios.post(url)
                .then((response) => {
                if (response.data.success) {
                    Swal.fire({
                        icon: 'success',
                        text: `Product marked as ${statusText} successfully.`,
                        confirmButtonText: 'OK'
                    });

                    const container = document.getElementById(`product-btn-${productId}`);
                    container.innerHTML = `
                    <button class="btn-sm btn-gradient-${isActive ? 'success' : 'danger'}"
                            onclick="toggleProductStatus('${productId}', ${!isActive})">
                        ${isActive ? 'Active' : 'Inactive'}
                    </button>
                    `;
                } else {
                    Swal.fire('Error!', 'Failed to update product status.', 'error');
                }
            })
            .catch((error) => {
                console.error(error);
                Swal.fire('Error!', 'An error occurred. Please try again.', 'error');
            });
        }
    });
}
</script>