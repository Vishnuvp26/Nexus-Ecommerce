<%- include("../layout/adminHeader") %>
<%- include("../layout/adminSidebarHead") %>
<link rel="stylesheet" href="/css/adminUsers.css">

<div class="main-panel">
  <div class="content-wrapper">

    <div class="page-header pt-5">
      <h3 class="page-title d-flex align-items-center">
        <span class="page-title-icon btn-gradient-primary text-white mr-2">
          <i class="mdi mdi-account-multiple menu-icon"></i>
        </span>
        Users
      </h3>
      <nav aria-label="breadcrumb" class="d-flex align-items-center mt-3">
        <form class="d-flex">
          <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" name="search" value="<%= searchQuery %>"/>
          <button class="btn btn-gradient-dark" type="submit">Search</button>
        </form>
      </nav>
    </div>

    <div class="col-lg-12 grid-margin stretch-card">
      <div class="card">
        <div class="card-body">

          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <th>No.</th>
                <th>Name</th>
                <th>Email</th>
                <th>Mobile</th>
                <th>Actions</th>  
              </tr>
            </thead>
            <tbody>
              <% if(userData.length > 0) { %>
                <% userData.forEach((user, index) => { %>
                  <tr>
                    <td><%= (currentPage - 1) * 5 + index + 1 %></td>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.phone %></td>
                    <td id="user-btn-<%= user._id %>">
                      <% if (user.is_blocked) { %>
                        <button class="btn-sm btn-gradient-success" onclick="toggleBlock('<%= user._id %>', true)" style="width: 100px;">Unblock</button>
                      <% } else { %>
                        <button class="btn-sm btn-gradient-danger" onclick="toggleBlock('<%= user._id %>', false)" style="width: 100px;">Block</button>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center">
                       No such users found
                      <div class="mt-4">
                          <a href="/admin/users" class="btn-sm btn-inverse-dark" style="text-decoration: none;">Go Back</a>
                      </div>
                  </td>
              </tr>
              <% } %>
            </tbody>
          </table>

          <!-- Pagination Container -->
          <div class="pagination-container mt-4">
            <ul class="pagination justify-content-center">
              <% if (currentPage > 1) { %>
                <li class="page-item">
                  <a class="page-link page-link-custom" href="?page=<%= currentPage - 1 %>" style="background-color: #fff; border-color: #000; color: #000;">Previous</a>
                </li>
              <% } %>
              <% for(let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= i === currentPage ? 'bg-dark text-light' : 'btn-light text-dark' %>" style="border-color: #000;">
                  <a class="page-link page-link-custom <%= i === currentPage ? 'bg-dark text-light' : 'btn-light text-dark' %>" href="?page=<%= i %>" style="border-color: #000;"><%= i %></a>
                </li>
              <% } %>
              <% if (currentPage < totalPages) { %>
                <li class="page-item">
                  <a class="page-link page-link-custom" href="?page=<%= currentPage + 1 %>" style="background-color: #fff; border-color: #000; color: #000;">Next</a>
                </li>
              <% } %>
            </ul>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<%- include("../layout/adminSidebarFoot") %>
<%- include("../layout/adminFooter") %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
function toggleBlock(userId, isBlocked) {
  const action = isBlocked ? 'unblock' : 'block';
  Swal.fire({
    title: `Are you sure you want to ${action} this user?`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: `Yes, ${action}`,
    cancelButtonText: 'Cancel',
    reverseButtons: true
  }).then((result) => {
    if (result.isConfirmed) {
      axios.get(`/admin/${action}User/?id=${userId}`)
        .then((response) => {
          if (response.data.success) {
            Swal.fire(`${action.charAt(0).toUpperCase() + action.slice(1)}ed!`, `User has been ${action}ed.`, 'success');

            // Update button in-place
            const container = document.getElementById(`user-btn-${userId}`);
            container.innerHTML = `
              <button class="btn-sm btn-gradient-${isBlocked ? 'danger' : 'success'}"
                      onclick="toggleBlock('${userId}', ${!isBlocked})"
                      style="width: 100px;">
                ${isBlocked ? 'Block' : 'Unblock'}
              </button>
            `;
          } else {
            Swal.fire('Error!', response.data.error || `Failed to ${action} the user.`, 'error');
          }
        })
        .catch(() => {
          Swal.fire('Error!', `An error occurred while trying to ${action} the user.`, 'error');
        });
    }
  });
}
</script>